# Lets the browser (WebUSB) use the IR tracker without root. Installed by install-udev-rule.sh.
# uaccess gives whoever is logged in at the computer access; the group rule is a fallback for remote or headless logins.
SUBSYSTEM=="usb", ATTR{idVendor}=="2104", ATTR{idProduct}=="0313", TAG+="uaccess", MODE="0660", GROUP="plugdev"
